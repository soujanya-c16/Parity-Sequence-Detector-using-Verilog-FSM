module seq_detector(x, clk, reset, z);
  input x, clk, reset;
  output reg z;
  parameter S0 = 2'b00,
          S1 = 2'b01,
          S2 = 2'b10,
          S3 = 2'b11;
  reg[1:0] PS, NS;
  
  always@(posedge clk or negedge reset)
    if(!reset)
      PS <= S0;
  else
    PS <= NS;
  
  always@(PS,x)
    case(PS)
      S0:begin
        z=0;
        NS = x? S0 : S1;
      end
      
      S1:begin
        z=0;
        NS = x? S2 : S1;
      end
      
       S2:begin
        z=0;
        NS = x? S3 : S1;
      end
      
       S3:begin
        z=0;
        NS = x? S0 : S1;
      end
      
    endcase
endmodule



